# Where the portal answers from. Must match the OIDC redirect URI exactly.
FAX_PUBLIC_ORIGIN=https://fax.pbx.services

# Authentik application "Innotel Fax" (client id innotel-fax).
FAX_OIDC_ISSUER=https://auth.cerulean.innotel.us/application/o/innotel-fax
FAX_OIDC_CLIENT_ID=innotel-fax
FAX_OIDC_CLIENT_SECRET=replace-me

# Who may use fax at all, and who gets the admin console.
FAX_ALLOWED_GROUPS=Zeus,Capstone
FAX_ADMIN_GROUPS=cerulean-platform

# 32+ random bytes; rotates every session, so rotating it signs everyone out.
FAX_SESSION_SECRET=replace-with-32-plus-random-characters

# The existing AvantFAX schema — shared with the PHP UI during the migration.
FAX_DB_HOST=127.0.0.1
FAX_DB_PORT=3306
FAX_DB_USER=avantfax
FAX_DB_PASSWORD=replace-me
FAX_DB_NAME=avantfax

# HylaFAX control path.
FAX_HYLAFAX_BIN=/usr/sbin
FAX_HYLAFAX_SPOOL=/var/spool/hylafax
FAX_CALLER_ID=fax@innotel.us

# Documents. Uploads are staged outside the spool; only normalised PDFs reach it.
FAX_ARCHIVE_DIR=/var/www/avantfax/faxes
FAX_QUARANTINE_DIR=/var/lib/fax-portal/quarantine
FAX_GHOSTSCRIPT_BIN=/usr/bin/gs
FAX_PDFTOTEXT_BIN=/usr/bin/pdftotext
# Optional OCR for scanned faxes; leave empty to index text-layer PDFs only.
FAX_OCR_BIN=

# Shared secret the mail transport presents on POST /hooks/inbound-email.
# Empty disables email-to-fax entirely (the route answers 503).
FAX_INBOUND_EMAIL_SECRET=

# Optional LLM triage of inbound faxes. Leave the key empty and nothing is sent
# anywhere: the Review page stays empty and no fax leaves the server.
# Any OpenAI-compatible chat-completions endpoint works.
FAX_TRIAGE_API_KEY=
FAX_TRIAGE_BASE_URL=https://gateway.innotel.us/v1
# Any router alias or model id the gateway knows. kilo-auto/free routes across
# the gateway's free providers and is the only free route that stayed up under
# repeated traffic; auto/best-free currently fails 502 on staging (its first
# pick needs Playwright, which the gateway host does not have).
FAX_TRIAGE_MODEL=kilo-gateway/kilo-auto/free
FAX_TRIAGE_PROVIDER=gateway.innotel.us
# Below this confidence a human has to confirm the category.
FAX_TRIAGE_MIN_CONFIDENCE=0.75
FAX_TRIAGE_MAX_CHARS=6000

PORT=3000
LOG_LEVEL=info
